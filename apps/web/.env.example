# OpsPilot Frontend - environment configuration template.
# Copy to .env.local for local development: cp .env.example .env.local
#
# Next.js inlines every NEXT_PUBLIC_* variable into the browser bundle at
# build time - never put a secret in this file or in any NEXT_PUBLIC_*
# variable.

# Base URL of the OpsPilot backend API, including the /api/v1 prefix.
# Local development default (safe to leave as-is):
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Production MUST override this with the real, HTTPS backend URL - e.g.
#   NEXT_PUBLIC_API_URL=https://api.your-domain.example/api/v1
# Shipping a production build with the localhost default means the deployed
# frontend cannot reach any backend at all.

# Optional, explicit opt-in (mirrors the backend's own APP_ENV). Leave unset
# for local development. When set to "production", the build fails fast if
# NEXT_PUBLIC_API_URL above is missing or still points at localhost - a
# guard against accidentally shipping a broken production build.
# NEXT_PUBLIC_APP_ENV=production
