# Application
APP_NAME=OpsPilot Backend
APP_ENV=development
APP_VERSION=dev
PORT=8080
API_PORT=8080
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY=24h
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# Database (used by a local Go process and by docker compose)
# DATABASE_URL=postgres://opspilot:replace-with-a-local-password@localhost:5432/opspilot?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=opspilot
DB_PASSWORD=replace-with-a-local-password
DB_NAME=opspilot
DB_SSLMODE=disable

# Docker Compose host port for PostgreSQL
POSTGRES_PORT=5432
