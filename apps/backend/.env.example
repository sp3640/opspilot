# OpsPilot Backend - environment configuration template.
# Copy to .env for local development: cp .env.example .env
# Every value below is a safe placeholder - never put real credentials here.
#
# Variables marked [REQUIRED IN PRODUCTION] are enforced by
# internal/config/config.go's Validate() whenever APP_ENV=production - the
# app refuses to start without them. Everything else is optional or has a
# safe default for local development.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=OpsPilot Backend
# development | test | staging | production
APP_ENV=development
PORT=8080
# Docker Compose host port mapping for the API container (compose-only, not read by the Go app itself)
API_PORT=8080
APP_VERSION=dev
# Gin's own mode switch (read directly by the gin-gonic library, not by internal/config).
# debug for local development; release is set automatically in Dockerfile/k8s for production.
GIN_MODE=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Preferred: a single PostgreSQL connection URL. When set, this takes
# precedence over the discrete DB_* variables below.
# [REQUIRED IN PRODUCTION] (either DATABASE_URL, or DB_HOST + DB_USER + DB_NAME)
# Use a TLS-enabled URL in production (sslmode=require or stronger) and URL-encode special characters.
# DATABASE_URL=postgres://opspilot:replace-with-a-strong-password@db-host:5432/opspilot?sslmode=require

# Legacy/local alternative to DATABASE_URL - a local Go process and docker
# compose both understand these discrete parts.
DB_HOST=localhost
DB_PORT=5432
DB_USER=opspilot
DB_PASSWORD=replace-with-a-local-password
DB_NAME=opspilot
DB_SSLMODE=disable
# Docker Compose host port mapping for the postgres container (compose-only, not read by the Go app itself)
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Authentication / Encryption
# ---------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION] Must be at least 32 characters. Generate with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY=24h

# [REQUIRED IN PRODUCTION] Must be base64 and decode to exactly 32 bytes.
# Encrypts stored cluster kubeconfigs and integration credentials at rest.
# Generate with:
#   openssl rand -base64 32
CLUSTER_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_WINDOW=1m
# Legacy alias names still accepted for backwards compatibility, in order of
# preference: RATE_LIMIT_REQUESTS, RATE_LIMIT_PER_MINUTE. Prefer
# RATE_LIMIT_REQUESTS_PER_MINUTE above for new configuration.

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
# How long the HTTP server will spend writing a single response
# (net/http.Server.WriteTimeout). Deployment creation/rollback run the
# Kubernetes deployment executor (90s timeout) synchronously in the request,
# so this must stay greater than 90s - enforced by internal/config's
# Validate(). Optional; defaults to 120s (90s executor + 30s margin) when unset.
HTTP_WRITE_TIMEOUT=120s

# ---------------------------------------------------------------------------
# CORS / Frontend origin
# ---------------------------------------------------------------------------
# Comma-separated list of origins allowed to call this API from a browser.
# [REQUIRED IN PRODUCTION] - must be explicit real origin(s); a wildcard "*"
# is rejected whenever APP_ENV=production. Defaults to the local frontend
# origin below when unset, which is fine for local development only.
# Example (production): CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Where GitHub OAuth (and any other browser redirect) sends the user back to.
# Also the base of the link in account verification emails
# (<FRONTEND_BASE_URL>/verify-email?token=...).
# [REQUIRED IN PRODUCTION] - must be the real frontend URL, not the localhost default.
FRONTEND_BASE_URL=http://localhost:3000

# Comma-separated list of proxy IPs/CIDR blocks (IPv4 or IPv6) allowed to set
# X-Forwarded-For/X-Real-IP for this process's c.ClientIP() - used by rate
# limiting (general, registration, resend-verification) and by login audit
# logging. Optional; unset means no proxy is trusted and ClientIP() uses the
# raw TCP peer, which is correct whenever this process is reachable directly.
#
# Set this explicitly when this process sits behind a reverse proxy/load
# balancer that is the ONLY way to reach it - e.g. on Google Cloud Run, whose
# request-routing layer does not publish a fixed CIDR range to name here
# instead:
#   TRUSTED_PROXIES=0.0.0.0/0,::/0
# (trust the immediate peer unconditionally - safe ONLY when nothing but
# that proxy can ever reach this process directly).
TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# GitHub OAuth integration (optional - "Connect with GitHub" is unavailable
# until these are set; a personal access token can still be used instead)
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/github/oauth/callback

# ---------------------------------------------------------------------------
# SMTP - sends account verification emails (registration) and email alert
# notifications through one provider.
#
# [REQUIRED IN PRODUCTION] SMTP_HOST and SMTP_FROM: startup fails without
# them when APP_ENV=production, because nobody could verify an account.
# Outside production, leaving SMTP_HOST empty is allowed but registration
# then answers 503 "email delivery unavailable" - point it at a local mail
# catcher (for example Mailpit on localhost:1025) to try the flow.
#
# SMTP_PORT 587 (STARTTLS) is the supported setup; implicit-TLS port 465 is
# not. SMTP_FROM must be an address on a domain you have verified with your
# email provider (SPF, DKIM and a DMARC policy published) or verification
# emails will land in spam or be rejected. Never commit real credentials.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# How long an emailed verification link stays valid (Go duration; default 24h).
EMAIL_VERIFICATION_TOKEN_TTL=24h
